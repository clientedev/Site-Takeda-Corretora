{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter @workspace/takeda-corretora dev",
    "build:client": "pnpm --filter @workspace/takeda-corretora run build",
    "build:server": "pnpm --filter @workspace/api-server run build",
    "build": "pnpm run build:client && pnpm run build:server",
    "start": "node artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
